# ClearSettle Configuration Environment Variables
# Copy to .env and customize as needed.

PORT=5000

# ----------------------------------------------------------------------
# PayPal Sandbox Credentials (Orders v2 REST API)
# ----------------------------------------------------------------------
# Real sandbox mode is the default per hard rules.
# Get credentials at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ----------------------------------------------------------------------
# Demo Provider Explicit Flag
# ----------------------------------------------------------------------
# Set to 'true' ONLY if you wish to run the simulated demo adapter without
# live PayPal credentials. When false/unset, real sandbox mode is enforced.
ENABLE_DEMO_PROVIDER=false

# ----------------------------------------------------------------------
# Google Gemini API Key (Structured JSON Output)
# ----------------------------------------------------------------------
# Get API key from: https://aistudio.google.com/
# If left blank, ClearSettle uses the deterministic Fallback Demo Parser.
GEMINI_API_KEY=

# Group Accounting Base Currency Anchor (EUR, USD, GBP, INR, JPY)
DEFAULT_BASE_CURRENCY=EUR

# ----------------------------------------------------------------------
# Google OAuth 2.0 / Identity Services (GSI)
# ----------------------------------------------------------------------
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Web client ID with authorized JavaScript origins (http://localhost:5000, https://<your-host>)
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------
# Database & Security Persistence
# ----------------------------------------------------------------------
# Optional path to SQLite file (e.g., for mounting persistent Docker volumes: /data/clearsettle.db)
DATABASE_PATH=clearsettle.db

# Optional administrative secret for protected administrative maintenance endpoints
ADMIN_SECRET=
